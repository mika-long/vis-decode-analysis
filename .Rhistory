# 'sidebar' | 'aboveStimulus' | 'belowStimulus' | 'stimulus'
BaseComponent <- function(
type,
path,
instruction,
instructionLocation = c("sidebar", "aboveStimulus", "belowStimulus"),
nextButtonLocation = c("sidebar", "aboveStimulus", "belowStimulus"),
parameters,
response_list = NULL) {
