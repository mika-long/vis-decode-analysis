#| eval: false
#| echo: false

ggsave(
  here("figs", "task2.y.weibull.ppcheck.pdf"),
  p1,
  width = 12,
  height = 6,
  units = "cm",
  dpi = 300
)

ggsave(
  here("figs", "task2.y.weibull.pit-ecdf.pdf"),
  p2,
  width = 6,
  height = 6,
  units = "cm",
  dpi = 300
)

```

