## Error on Y, Log-Normal {#sec-y-logNormal}

Math formula: 
$$
\begin{align*}
\texttt{error.y}_i &\sim \text{Log-Normal}(\mu_{\text{PID}[i]},\ \sigma_{\text{PID}[i]}) \\
\mu_j &= \alpha_j \\
\log(\sigma_j) &= \beta_j \\
\alpha_j &\sim \mathcal{N}(\mu_\alpha,\ \tau_\alpha) \\
\beta_j &\sim \mathcal{N}(\mu_\beta,\ \tau_\beta) \\
\mu_\alpha,\ \mu_\beta &\sim \mathcal{N}(0, 1) \\
\tau_\alpha,\ \tau_\beta &\sim \mathcal{N}^{+}(0, 1)
\end{align*}
$$

Specify formula and prior: 

```{r}
f <- bf(
  error.y ~ 0,
  mu ~ (1 | participantId),
  sigma ~ (1 | participantId),
  family = lognormal()
)

p <- c(
  prior(normal(0, 1), class = Intercept),
  prior(normal(0, 1), class = sd, group = participantId, lb = 0),
  prior(normal(0, 1), class = Intercept, dpar = sigma),
  prior(normal(0, 1), class = sd, group = participantId, dpar = sigma, lb = 0)
)
``` 

```{r}
#| eval: false
#| echo: false

task2_df %>%
  mutate(error.y = va.ans.y - va.resp.y) %>%
  mutate(error.y = ifelse(error.y < tolerance, tolerance, error.y)) %>%
  get_prior(formula = f, data = .)

task2_df %>%
  mutate(
    error = abs(
      data_to_screen_slope(data.select.slope) -
        data_to_screen_slope(data.ans.slope)
    ) +
      epsilon
  ) %>%
  make_stancode(formula = f, prior = p)
```

```{r}
#| output: false
#| label: fit lognormal

model.y.lognormal <- task2_df %>%
  mutate(error.y = va.ans.y - va.resp.y) %>%
  mutate(error.y = ifelse(error.y < tolerance, tolerance, error.y)) %>%
  brm(
    formula = f,
    data = .,
    prior = p,
    chains = 4,
    cores = 4,
    file = here("analysis", "fitted_models", "part1", "task2.y.lognormal"),
    file_refit = "on_change",
    save_pars = save_pars(all = TRUE),
    control = list(adapt_delta = 0.99),
    iter = 6000
  )
```

Check fit and posterior: 

```{r}
summary(model.y.lognormal)
plot(model.y.lognormal)
```

```{r}
#| layout-ncol: 2
pp_check(model.y.lognormal, ndraws = 100)
pp_check(model.y.lognormal, ndraws = 100, type = "pit_ecdf")
```

```{r}
#| eval: false
#| echo: false

# Overlay plot

task2_df %>%
  modelr::data_grid(error.y = 0) %>%
  add_predicted_draws(model.y.lognormal, ndraws = 100, re_formula = NA) %>%
  ggplot() +
  stat_slab(aes(x = .prediction), fill = "lightblue", alpha = 1) +
  geom_dots(data = task2_df, aes(x = va.ans.y - va.resp.y)) +
  labs(y = "Probability", x = "Signed error", title = "Task 2") +
  theme_minimal(base_size = 8) -> p

p
```

## Error on Y, Gamma {#sec-y-gamma}

Math formula: 

$$
\begin{align*}
\texttt{error.y}_i &\sim \text{Gamma}(\mu_{\text{PID}[i]},\ k_{\text{PID}[i]}) \\
\mu_j &= \alpha_j^{-1} \\
\log(k_j) &= \beta_j \\
\alpha_j &\sim \mathcal{N}(\mu_\alpha,\ \tau_\alpha) \\
\beta_j &\sim \mathcal{N}(\mu_\beta,\ \tau_\beta) \\
\mu_\alpha,\ \mu_\beta &\sim \mathcal{N}(0, 1) \\
\tau_\alpha,\ \tau_\beta &\sim \mathcal{N}^{+}(0, 1)
\end{align*}
$$

Specify formula and prior: 

```{r}
f <- bf(
  error.y ~ 0,
  mu ~ (1 | participantId),
  shape ~ (1 | participantId),
  family = Gamma()
)

p <- c(
  prior(normal(0, 1), class = Intercept),
  prior(normal(0, 1), class = sd, group = participantId, lb = 0),
  prior(normal(0, 1), class = Intercept, dpar = shape),
  prior(normal(0, 1), class = sd, group = participantId, dpar = shape, lb = 0)
)
```

```{r}
#| eval: false
#| echo: false

task2_df %>%
  mutate(error.y = va.ans.y - va.resp.y) %>%
  mutate(error.y = ifelse(error.y < tolerance, tolerance, error.y)) %>%
  get_prior(formula = f, data = .)

task2_df %>%
  mutate(
    error = abs(
      data_to_screen_slope(data.select.slope) -
        data_to_screen_slope(data.ans.slope)
    ) +
      epsilon
  ) %>%
  make_stancode(formula = f, prior = p)
```

```{r}
#| output: false
#| label: fit gamma

model.y.gamma <- task2_df %>%
  mutate(error.y = va.ans.y - va.resp.y) %>%
  mutate(error.y = ifelse(error.y < tolerance, tolerance, error.y)) %>%
  brm(
    formula = f,
    data = .,
    prior = p,
    chains = 4,
    cores = 4,
    file = here("analysis", "fitted_models", "part1", "task2.y.gamma"),
    file_refit = "on_change",
    save_pars = save_pars(all = TRUE),
    control = list(adapt_delta = 0.99),
    iter = 6000
  )
```

Note that the above have a lot of divergent transitions, even though we took `adapt_delta = 0.99`, suggesting that this is a bad posterior fit, and that this is not the right model. 

Nevertheless, we check its posterior fit for completeness: 

```{r}
#| warning: true
summary(model.y.gamma)
```

Checking the PIT-ECDF plot to confirm that the posterior fit is bad:  

```{r}
pp_check(model.y.gamma, type = "pit_ecdf")
```

## LOO Comparison {#sec-y-loo}

Note that we won't use [Gamma](#sec-y-gamma) in the model comparison, because the models have divergent transitions after fitting and demonstrate poor calibration. 

Loo comparison: 

```{r}
#| label: compute Y loo
#| cache: true

brms::loo(
  model.y.lomax,
  model.y.exponential,
  model.y.lognormal,
  model.y.weibull,
  moment_match = TRUE,
  reloo = FALSE,
  cores = parallel::detectCores()
)
```

Weibull is the best model. 

---

# Error on X, Normal distribution {#sec-x-normal}

Math model: 

$$
\begin{align}
\text{error_va}_{i} &\sim \text{Normal}(\mu_\text{PID[i]}, \sigma_{\text{PID[i]}}^2) \\
\mu_j &\sim \mathcal{N}(\bar{\mu}, \bar{\sigma}^2), j \in [16] \\ 
\sigma_j &\sim \mathcal{N}^+(\alpha, \beta^2), j \in [16] \\ 
\bar{\mu}, \alpha &\sim \mathcal{N}(0, 1)\\
\bar{\sigma}, \beta &\sim \mathcal{N}^+(0, 1)
\end{align}
$$

Formula and prior: 

```{r}
f <- bf(
  error.x ~ 0,
  mu ~ (1 | participantId),
  sigma ~ (1 | participantId),
  family = gaussian
)

# sigma has log-link, so we don't pose any bounds on it
p <- c(
  prior(normal(0, 1), class = Intercept),
  prior(normal(0, 1), class = sd, group = participantId, lb = 0),
  prior(normal(0, 1), class = Intercept, dpar = sigma),
  prior(normal(0, 1), class = sd, group = participantId, dpar = sigma, lb = 0)
)
```

```{r}
#| eval: false
#| echo: false

task2_df %>% mutate(error.x = va.resp.x - va.ans.x) %>% get_prior(f, data = .)

task2_df %>%
  mutate(error.x = va.resp.x - va.ans.x) %>%
  make_stancode(f, data = ., prior = p)
```

Fit the model: 

```{r}
#| output: false

model.x.normal <- task2_df %>%
  mutate(error.x = va.resp.x - va.ans.x) %>%
  brm(
    formula = f,
    data = .,
    prior = p,
    chains = 4,
    cores = 4,
    file = here("analysis", "fitted_models", "part1", "task2.x.normal"),
    file_refit = "on_change",
    control = list(adapt_delta = 0.99),
    iter = 6000,
    save_pars = save_pars(all = TRUE)
  )
```

Check fit and posterior:

```{r}
summary(model.x.normal)
plot(model.x.normal)
```

```{r}
#| layout-ncol: 2
pp_check(model.x.normal, ndraws = 100) +
  theme(legend.position = c(0.9, 0.5)) +
  theme(text = element_text(size = 10)) -> task2.x.gaussian

pp_check(model.x.normal, ndraws = 100, type = "pit_ecdf") +
  theme(text = element_text(size = 10)) -> task2.x.gaussian.pit

task2.x.gaussian
task2.x.gaussian.pit
```

```{r}
#| eval: false
#| echo: false

ggsave(
  here("figs", "task2.x.gaussian.ppcheck.pdf"),
  task2.x.gaussian,
  height = 5,
  width = 10,
  unit = "cm",
  dpi = 300
)

ggsave(
  here("figs", "task2.x.gaussian-pit.pdf"),
  task2.x.gaussian.pit,
  height = 6,
  width = 6,
  unit = "cm",
  dpi = 300
)
```

:::{.callout-important}
Get the posterior for fitting another operator (i.e., `BisectArea`): 

```{r}
# model.x.normal %>% get_variables(.)

model.x.normal %>%
  spread_draws(b_Intercept, b_sigma_Intercept) %>%
  mutate(b_sigma = exp(b_sigma_Intercept)) %>%
  pivot_longer(cols = c(b_Intercept, b_sigma)) %>%
  ggplot(aes(x = value, y = name)) +
  stat_halfeye()
```

```{r}
model.x.normal %>%
  spread_draws(b_Intercept, b_sigma_Intercept) %>%
  mutate(b_sigma = exp(b_sigma_Intercept)) %>%
  pivot_longer(cols = c(b_Intercept, b_sigma)) %>%
  group_by(name) %>%
  median_qi(value, .width = c(0.66, 0.95))
```

:::

# From error on Y to error on X 

Get the "average participant": 

```{r}
avg_pixelToMM <- participants %>% pull(pixelToMM) %>% mean(.)
avg_distToScreen <- participants %>% pull(dist_to_screen) %>% mean(.)
avg_participant <- tibble(
  pixelToMM = avg_pixelToMM,
  distToScreen = avg_distToScreen
)
```

Create dataframe for average participant and do posterior draws: 

```{r}
newdata <- avg_participant %>% mutate(participantId = "avg_participant")

# Y-error draws in visual angle space
y_draws <- newdata %>%
  add_predicted_draws(
    model.y.weibull,
    re_formula = NULL, # include random effects
    allow_new_levels = TRUE,
    # ndraws = 4000
  )
```

# Plot the marginalized example to use for paper

So here are the parameters of the particular example we're looking at: 
$\mu = -1.1, \sigma = 0.9, \lambda = -0.3, p = 2.6, q = 2.17$. The highest point has x coordinate `-1.1` and y coordinate `dsgt(-1.1, ...)`. 

```{r}
#| code-fold: true
x <- seq(-5, 5, length.out = 100)
y <- dsgt(
  x,
  mu = -1.1,
  sigma = 0.9,
  lambda = -0.3,
  p = 2.6,
  q = 2.17,
  mean.cent = FALSE
)

x_val = -1.1
y_val = dsgt(
  x_val,
  mu = -1.1,
  sigma = 0.9,
  lambda = -0.3,
  p = 2.6,
  q = 2.17,
  mean.cent = FALSE
)

example_plot <- tibble(x = x, y = y) %>%
  ggplot(aes(x = x, y = y)) +
  geom_line() +
  coord_cartesian(xlim = c(-5, 5), ylim = c(0, 1)) +
  theme_tidybayes() +
  geom_vline(xintercept = x_val, linetype = "dashed", color = "gray") +
  geom_hline(
    yintercept = y_val,
    linetype = "dashed",
    color = "gray"
  )
example_plot
```

```{r}
#| code-fold: true
# specific pdf we're working with
f <- function(x) {
  dsgt(
    x,
    mu = -1.1,
    sigma = 0.9,
    lambda = -0.3,
    p = 2.6,
    q = 2.17,
    mean.cent = FALSE
  )
}

va.ans.y <- exp1_y$data_to_va(y_val, avg_distToScreen, avg_pixelToMM)

x_errors <- y_draws %>%
  mutate(
    va.pred.y = va.ans.y - .prediction,
    num.pred.y = exp1_y$va_to_data(va.pred.y, avg_distToScreen, avg_pixelToMM),
    eps_data = y_val - num.pred.y
  ) %>%
  rowwise() %>%
  mutate(
    x_left = uniroot(function(x) f(x) - num.pred.y, c(-5, x_val))$root,
    x_right = uniroot(function(x) f(x) - num.pred.y, c(x_val, 5))$root,
    # random flip betwee x_left and x_right
    num.pred.x = if (sample(c(TRUE, FALSE), 1)) x_left else x_right
  )
```

So we will use this plot as our example for things to marginalize. 

```{r}
#| code-fold: true
theme_set(theme_tidybayes(base_size = 10))

x_graph <- x_errors %>%
  ggplot(aes(x = num.pred.x)) +
  stat_slab() +
  coord_cartesian(xlim = c(-5, 5)) +
  scale_y_continuous(breaks = 0) +
  labs(x = "", y = "density")

y_graph <- x_errors %>%
  ggplot(aes(y = num.pred.y)) +
  stat_slab() +
  coord_cartesian(ylim = c(0, 1)) +
  scale_x_continuous(breaks = 0) +
  labs(x = "density", y = "")
```

Use patchwork to put things together: 

```{r}
library(patchwork)

new_output <- example_plot +
  y_graph +
  x_graph +
  plot_spacer() +
  plot_layout(
    ncol = 2,
    nrow = 2,
    widths = c(4, 0.5),
    heights = c(3, 0.5)
  )

new_output
```

Error on y is too hard to see, so we also create a zoomed-in version of it: 

```{r}
#| code-fold: true

y_zoom <- y_graph +
  coord_cartesian(ylim = c(0.45, 0.5)) +
  labs(x = "") +
  # theme_tidybayes(base_size = 6) +
  scale_y_continuous(breaks = c(0.45, 0.50))

y_zoom
```

```{r}
#| eval: false
#| echo: false

ggsave(
  here::here("figs", "new.svg"),
  new_output,
  units = "in",
  width = 3.5,
  height = 3.5 / 4.6 * 3.5,
  dpi = 300
)

ggsave(
  here::here("figs", "new_y_zoom.svg"),
  y_zoom,
  height = 300,
  width = 450,
  units = "px",
  dpi = 300
)
```


